#!/usr/bin/env python3
"""Print (or record) the ts of the current hourly-heartbeat thread in #heydonna-dev.

  hourly-thread-ts                 print current ts; exit 1 if missing or stale
  hourly-thread-ts --set <ts>      record a new hourly post (called by Skill(hourly-heartbeat))
  hourly-thread-ts --json          print the full state record

PR tracking replies (admission/merge asks, PR status, CI/capture follow-ups) go to
`slack-send.sh -c C0ALZJHGE49 -t "$(hourly-thread-ts)" -f < msg`. Rajiv 2026-09-29
11:02 IST, thread 1790659381.537339: "the hourly thread should be used for any
further tracking or pr's." The old thread 1790531842.023499 is retired.
"""

import argparse
import json
import os
import re
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

STATE = Path(os.environ.get(
    "HOURLY_THREAD_STATE",
    str(Path.home() / ".claude/projects/-Users-rajiv-Downloads-projects-heydonna-app/state/hourly-thread.json"),
))
CHANNEL = "C0ALZJHGE49"
PM_OPS = os.environ.get("PM_OPS", str(Path.home() / ".claude/scripts/pm-ops.py"))
PM_OPS_DB = os.environ.get(
    "PM_OPS_DB",
    str(Path.home() / ".claude/projects/-Users-rajiv-Downloads-projects-heydonna-app/state/pm-ops.db"),
)
HOURLY_KIND = "hourly_report_due"


def resolve_hourly_report_due(ts: str) -> list[int]:
    """Resolve MoP's open hourly_report_due rows for the post's bucket and older.

    Rajiv D0AMF0XE6TS ts 1793784122.949659: "hourly report should never be
    missed. can MoP add an obligation for it automatically?" MoP opens one row
    per hourly bucket (YYYY-MM-DD:HH, local); this post resolves the current or
    most recent bucket(s). Fails open: the thread ts is already recorded.
    """
    bucket = time.strftime("%Y-%m-%d:%H", time.localtime(float(ts)))
    try:
        con = sqlite3.connect(f"file:{PM_OPS_DB}?mode=ro", uri=True, timeout=5)
        try:
            rows = con.execute(
                "SELECT id, target_id FROM obligations WHERE status='open' AND kind=?",
                (HOURLY_KIND,),
            ).fetchall()
        finally:
            con.close()
    except sqlite3.Error as exc:
        print(f"hourly_report_due lookup skipped: {exc}", file=sys.stderr)
        return []
    resolved: list[int] = []
    for oid, target in rows:
        if not isinstance(target, str) or target > bucket:
            continue
        try:
            subprocess.run(
                [sys.executable, PM_OPS, "obligation-resolve", "--kind", HOURLY_KIND, "--id", str(oid),
                 "--reason", f"hourly report posted ts={ts} (bucket {bucket})"],
                check=True, timeout=15, capture_output=True,
            )
            resolved.append(int(oid))
        except (OSError, subprocess.SubprocessError) as exc:
            print(f"hourly_report_due resolve failed id={oid}: {exc}", file=sys.stderr)
    return resolved


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--set", metavar="TS")
    p.add_argument("--json", action="store_true")
    p.add_argument("--max-age-min", type=int, default=150, help="treat older records as stale (default 150)")
    a = p.parse_args()
    if a.set:
        if not re.fullmatch(r"\d{10}\.\d{6}", a.set):
            print(f"invalid Slack ts: {a.set}", file=sys.stderr)
            return 2
        STATE.parent.mkdir(parents=True, exist_ok=True)
        tmp = STATE.with_suffix(".tmp")
        tmp.write_text(json.dumps({"channel": CHANNEL, "ts": a.set, "recorded_at": int(time.time())}))
        tmp.replace(STATE)
        print(a.set)
        for oid in resolve_hourly_report_due(a.set):
            print(f"resolved hourly_report_due obligation {oid}", file=sys.stderr)
        return 0
    try:
        rec = json.loads(STATE.read_text())
    except (OSError, ValueError):
        print(f"no hourly thread recorded at {STATE}", file=sys.stderr)
        return 1
    if a.json:
        print(json.dumps(rec))
        return 0
    age_min = (time.time() - float(rec["ts"])) / 60
    if age_min > a.max_age_min:
        print(f"hourly thread {rec['ts']} is stale ({age_min:.0f}m old)", file=sys.stderr)
        return 1
    print(rec["ts"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
